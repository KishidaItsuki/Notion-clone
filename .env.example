# SQLite データベースファイルの場所（初回起動時に自動作成されます）
DATABASE_PATH="./data/app.db"

# セッション署名用の秘密鍵（必ず長いランダム文字列に変更してください）
#   生成例: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# アプリの公開URL（末尾の / は不要）。Google の「承認済みのリダイレクト URI」は
#   <APP_URL>/api/auth/google/callback
# になります。ローカル開発時は http://localhost:3000
APP_URL="http://localhost:3000"

# Google Cloud Console で作成した OAuth クライアントの ID とシークレット
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 管理者のメールアドレス（カンマ区切りで複数可）。
# この人は承認なしでログインでき、常に管理者になります。
ADMIN_EMAILS="you@example.com"
