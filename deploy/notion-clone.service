# TeamNotes を常駐させる systemd の設定
#
# 設置:  sudo cp deploy/notion-clone.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now notion-clone
# 状態:  sudo systemctl status notion-clone
# ログ:  journalctl -u notion-clone -f
#
# User と WorkingDirectory は、サーバーの構成に合わせて変更してください。

[Unit]
Description=TeamNotes (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/notion-clone
Environment=NODE_ENV=production
# .env は Next.js が WorkingDirectory から自動で読み込む
# 127.0.0.1 で待ち受け、外部からの接続は Caddy（HTTPS）経由だけにする
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

# 最低限の保護設定
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
